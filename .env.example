PORT=3000
PUBLIC_URL=https://site-text-bot.onrender.com
DATABASE_URL=postgres://postgres@localhost:5432/site_text_bot

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1702...

# Seeds the allowlist with you as owner on startup
OWNER_PHONE=+1702...
OWNER_NAME=Myles

# Fine-grained token for enriquezm/new-smyles: Contents + Pull requests (read/write)
GITHUB_TOKEN=
GITHUB_OWNER=enriquezm
GITHUB_REPO=new-smyles
GITHUB_BASE_BRANCH=main

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=

# Fallback if Render's preview link can't be found on the PR; {pr} = PR number
PREVIEW_URL_TEMPLATE=

THREAD_TTL_MINUTES=60

# Local development only: skip Twilio signature checks (refused in production)
SKIP_TWILIO_SIGNATURE=false
