{
  "name": "site-text-bot",
  "version": "0.1.0",
  "description": "Text-message bot that edits and deploys the portfolio site",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@fastify/formbody": "^9.0.1",
    "@octokit/rest": "^22.0.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "twilio": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
